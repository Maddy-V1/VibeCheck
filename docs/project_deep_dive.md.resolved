## Database Schema (12 tables + enums)

```mermaid
erDiagram
    profiles ||--o{ projects : "submits"
    profiles ||--o{ notifications : "receives"
    profiles ||--o{ reactions : "creates"
    profiles ||--o{ comments : "writes"
    projects ||--o| evaluations : "has"
    projects ||--o| queue : "enters"
    projects ||--o{ badges : "earns"
    projects ||--o{ reactions : "receives"
    projects ||--o{ comments : "receives"
    projects ||--o{ project_rankings : "ranked in"
    evaluations ||--o{ project_rankings : "referenced by"
    comments ||--o{ comment_reactions : "has"
    comments ||--o{ comment_flags : "flagged"

    profiles {
        uuid id PK
        text username UK
        text display_name
        text avatar_url
        text bio
        boolean is_evaluator
        text evaluator_role
        boolean onboarding_done
        enum community_status
    }

    projects {
        uuid id PK
        uuid user_id FK
        text title
        text description
        enum tier
        enum status
        text live_url
        text github_url
        text demo_video_url
        text[] tech_stack
        int reaction_count
        int comment_count
    }

    evaluations {
        uuid id PK
        uuid project_id FK
        uuid evaluator_id FK
        int score_functionality
        int score_ux
        int score_complexity
        int score_deployment
        int score_code_quality
        int score_documentation
        int score_originality
        int score_total
        text reviewer_note
        text internal_notes
        enum tier_confirmed
    }

    queue {
        uuid id PK
        uuid project_id FK
        int position
        enum plan
        int estimated_days
        uuid assigned_evaluator
    }

    badges {
        uuid id PK
        uuid project_id FK
        uuid user_id FK
        enum badge_type
        text verification_id
        text certificate_url
        text certificate_pdf_url
    }
```

